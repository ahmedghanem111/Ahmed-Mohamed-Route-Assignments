PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/nest_app

# Redis
REDIS_URL=redis://:change_me@localhost:6379

# Generate JWT secrets with at least 32 random bytes each.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Base64 encoding of exactly 32 random bytes. Example generation:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=Nest App <no-reply@example.com>

# Frontend routes that receive email links
FRONTEND_URL=https://app.example.com

# Google reCAPTCHA; set CAPTCHA_VERIFY_URL only for a compatible provider.
RECAPTCHA_SECRET_KEY=replace_with_recaptcha_secret
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
# Optional hostname check when the provider returns a hostname.
RECAPTCHA_EXPECTED_HOSTNAME=app.example.com
